API_PORT=8787
PUBLIC_API_BASE_URL=https://api.example.com
VITE_REOWN_PROJECT_ID=

# Runtime database used by the backend. Create it with scripts/create-production-database.ps1 first.
DATABASE_URL=postgres://event_signal_app:change_me@127.0.0.1:5432/event_signal_prod
DB_MAX_CONNECTIONS=40

# Security
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://api.example.com
APP_ENCRYPTION_KEY=base64_or_hex_32_bytes

# Binance
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
EXCHANGE_SYNC_INTERVAL_SECONDS=2
BINANCE_BALANCE_REFRESH_LIMIT=100
BINANCE_ORDER_CONFIRM_LIMIT=100
BINANCE_SETTLEMENT_SYNC_LIMIT=100
MARKET_DATA_PRIMARY=https://fapi.binance.com
MARKET_WS_URL=wss://fstream.binance.com/market/stream?streams=btcusdt@aggTrade/btcusdt@markPrice@1s/btcusdt@kline_1m
PREDICTION_INTERVAL_SECONDS=1
PREDICTION_CANDLE_LIMIT=720
PREDICTION_STALE_SECONDS=5
PREDICTION_UP_THRESHOLD=8
PREDICTION_DOWN_THRESHOLD=-8
PREDICTION_MIN_CONFIDENCE=0.72
PREDICTION_SIGNAL_COOLDOWN_SECONDS=60

# BSC verification
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_VAULT_CONTRACT=0x0000000000000000000000000000000000000000
BSC_SETTLEMENT_WALLET=0x0000000000000000000000000000000000000000
BSC_MIN_CONFIRMATIONS=6
BSC_DEPOSIT_SYNC_INTERVAL_SECONDS=6
BSC_DEPOSIT_SYNC_LIMIT=100
BSC_RPC_TIMEOUT_SECONDS=8
